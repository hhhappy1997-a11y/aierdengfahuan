; Godot 4 工程配置（Rank-1 交付件，工位内文本件；R2 建立 / R3 口径补齐，功能键值不重做）
; 供建立工程根时拷贝到 F:\Game\aierdengfahuan\project.godot
;
; [R3 口径补齐 2026-11-09]
; - config_version：本机引擎 D:\Godot\Godot_v4.7.2-stable_win64.exe --version
;   R3 复核实测 4.7.2.stable.official.ed1daf0bf（EXIT=0）。config_version 是 Godot 工程
;   配置格式版本（整数），Godot 4.x 为 5，不是引擎版本号；本值经三段门禁真跑验证被引擎接受。
; - 纹理：任务书 R3 字面写 rendering/textures/canvas_items/default_texture_filter=0，
;   但 Godot 4 合法键为 textures/canvas_textures/default_texture_filter（R1 §5 第 2 项、
;   R2 §2、契约 §5 均已纠正）。本轮沿用引擎合法键 =0（Nearest）；像素图导入统一
;   lossless / 关闭 mipmaps / texture_filter=Nearest（项目级 default_texture_filter=0 兜底，
;   逐图 .import 由 4 号 I-5 import.json 落位）。canvas_items 为历史误写，不写回，见 DONE-R3.md。
; - 3D：Jolt Physics + 固定 physics_ticks_per_second=60（[physics] 段）。
; - 输入：[input] 段 15 个 action 完整映射表（移动 / 轻攻击 / 重攻击 / 翻滚 / 防御 /
;   锁定 / 道具 / 交互 / 菜单 / 调试 HUD / 调试重载 chunk），键鼠与方向键齐备。
; - 主场景：run/main_scene="res://scenes/Main.tscn"；自 R3 起由 build_main.gd 程序化生成，
;   手写 场景树骨架.tscn 保留为结构示意（R1 §6：落工程改走构建脚本）。
;
; 5 个 autoload 的归属口径见 00-续派与监测规则.md §6 第 3 条：GameEvents 由 3 号实现、1 号注册。
; 跨工位脚本（WorldState / GameEvents / SaveSystem）的最终实现由 3 号提供，1 号只在此登记路径。
;
; [R8 装配层闭合 2026-11-09，HOST 授权 cmd-20261109-024906-799-A1]
; R7 全工程门禁 18 条 ERROR 全部来自下列 3 个 autoload 指向了不存在的脚本。
; 裁决结果（3 个注册项分两类闭合，均不写 3 号 scripts/rpg/ 目录）：
;   - WorldState / GameEvents：3 号实际落位在 scripts/rpg/，注册路径改指向实际落位；
;   - SaveSystem：全工程根无 save_system.gd，由 Rank-1 在自身可写的 scripts/world/
;     补「装配占位」件（不实现存档读写，存档按 I-1 / 契约 §6 仍归 3 号），
;     注册路径保持不变即指向该占位件；真实实现落位后由 HOST 裁决再改指向。
; 至此 5 个 autoload 全部指向工程中实际存在的脚本。

config_version=5

[application]

config/name="艾尔登法环 · HD-2D"
config/description="2.5D HD-2D 法环同人：3D 地形 + 2D 像素角色"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false

[autoload]

WorldState="*res://scripts/rpg/world_state.gd"
GameEvents="*res://scripts/rpg/game_events.gd"
SaveSystem="*res://scripts/world/save_system.gd"
ChunkManager="*res://scripts/world/chunk_streaming.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
; R20 裁决 A9（cmd-20261109-110237-805-A3）：正式注册第 6 个 autoload SaveDeltaWriter，
; 指向 3 号新写的 scripts/save_delta_writer.gd（commit(reason) 强制落盘），
; 兑现 HUD.travel_to「先 commit 后发信号」。既有 5 项 autoload 与
; [rendering] textures/vram_compression/import_etc2_astc=true 保持不变。
SaveDeltaWriter="*res://scripts/save_delta_writer.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[hd2d]

; 工程侧冻结值（供 4 号 A4 / A8 对齐，详见 DONE-R2.md「给 4 号的冻结值」）
render/low_resolution_width=640
render/low_resolution_height=360
render/integer_upscale_factor=2
render/pixels_per_meter=32.0
; 桌面 / 移动双档画质 Resource（数值落在这两个 .tres 里，本段只登记路径与默认档）
quality/default_preset="res://data/render/quality_preset_desktop.tres"
quality/mobile_preset="res://data/render/quality_preset_mobile.tres"

[input]

move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 87), Object(InputEventKey, "keycode": 4194320)]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 83), Object(InputEventKey, "keycode": 4194322)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 65), Object(InputEventKey, "keycode": 4194319)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 68), Object(InputEventKey, "keycode": 4194321)]
}
light_attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index": 1), Object(InputEventKey, "physical_keycode": 74)]
}
heavy_attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index": 2), Object(InputEventKey, "physical_keycode": 75)]
}
roll={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 32)]
}
guard={
"deadzone": 0.2,
"events": [Object(InputEventKey, "keycode": 4194325)]
}
lock_on={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton, "button_index": 3), Object(InputEventKey, "physical_keycode": 81)]
}
use_item={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 82)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey, "physical_keycode": 69)]
}
menu={
"deadzone": 0.2,
"events": [Object(InputEventKey, "keycode": 4194305)]
}
debug_perf_hud={
"deadzone": 0.2,
"events": [Object(InputEventKey, "keycode": 4194334)]
}
debug_reload_chunk={
"deadzone": 0.2,
"events": [Object(InputEventKey, "keycode": 4194335)]
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]
textures/vram_compression/import_etc2_astc=true

; 桌面档 / 移动档共用渲染基线；两档 FX 与缓冲差异见 quality_preset_*.tres
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 项目级 Nearest：注意合法键为 canvas_textures，不是 canvas_items（R2 §2 特别指定）
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.07, 0.1, 0.16, 1)
