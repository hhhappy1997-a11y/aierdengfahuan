[gd_resource type="Resource" script_class="TrialModifierConfig" format=3]

[ext_resource type="Script" path="res://scripts/combat/trial_modifier_config.gd" id="1_tmc"]

[resource]
script = ExtResource("1_tmc")
modifiers = Array[Dictionary]([{
"id": "no_hit",
"title": "试炼词条·无伤",
"description": "全程不受一次伤害完成试炼；不额外压缩时限或血量，以操作门槛换取最高档加成。",
"reward_multiplier": 1.5,
"time_limit_scale": 1.0,
"hp_scale": 1.0,
"exclusive_group": "survival"
}, {
"id": "time_pressure",
"title": "试炼词条·限时",
"description": "把既有波次时限按比例压缩后再清场；节奏压力，可与生存类词条共存。",
"reward_multiplier": 1.3,
"time_limit_scale": 0.6,
"hp_scale": 1.0,
"exclusive_group": "tempo"
}, {
"id": "low_vigor",
"title": "试炼词条·低血量",
"description": "起始血量按比例压低并维持低血量通关；与无伤同属生存限制，二者不可叠加。",
"reward_multiplier": 1.4,
"time_limit_scale": 1.0,
"hp_scale": 0.5,
"exclusive_group": "survival"
}])
