[sub_resource type="Resource" id="Resource_l01"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_01"
speaker = "守钟人·伊莱"
text = "钟窖底下还留着一枚钟舌。你若下去，替我取回来。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l02"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_02"
speaker = "守钟人·伊莱"
text = "它本该在黄昏敲响，让走失的人认得回家的路。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l03"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_03"
speaker = "守钟人·伊莱"
text = "井底那扇门只肯从里头开。别指望原路回来。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l04"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_04"
speaker = "守钟人·伊莱"
text = "不急。钟不会跑，我也不会。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l05"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_05"
speaker = "守钟人·伊莱"
text = "那么去吧。别碰大钟本身——守钟人还醒着。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l06"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_06"
speaker = "守钟人·伊莱"
text = "拿回钟舌，回来找我。或者，不回来也行。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l07"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_07"
speaker = "守钟人·伊莱"
text = "井底的锈钥匙在回廊，别漏了。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l08"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_08"
speaker = "守钟人·伊莱"
text = "没听见钟响，我就当你还在路上。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l09"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_09"
speaker = "守钟人·伊莱"
text = "你手里那道金光……是钟舌。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l10"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_10"
speaker = "守钟人·伊莱"
text = "交给我，让黄昏再响一次；或者，你自己留着。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l11"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_11"
speaker = "守钟人·伊莱"
text = "好。等第一声钟响，你会知道这条路没白走。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l12"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_12"
speaker = "守钟人·伊莱"
text = "你把钟舌留在了自己手里。也罢，钟认得它的主人。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l13"]
script = ExtResource("1_line")
line_id = "line_bellkeeper_13"
speaker = "守钟人·伊莱"
text = "钟会记得你。去吧，别在井底待太久。"
portrait_id = "portrait_npc_bellkeeper"

[sub_resource type="Resource" id="Resource_l14"]
script = ExtResource("1_line")
line_id = "line_memory_01"
speaker = "记忆的余响"
text = "钟声曾从这里出发，穿过雾，落回每个走失的人耳边。"
gates = [SubResource("Resource_g08")]
portrait_id = ""

[sub_resource type="Resource" id="Resource_l15"]
script = ExtResource("1_line")
line_id = "line_memory_02"
speaker = "记忆的余响"
text = "钟舌被留在了别处。从此黄昏只有风，没有响。"
gates = [SubResource("Resource_g07")]
portrait_id = ""


