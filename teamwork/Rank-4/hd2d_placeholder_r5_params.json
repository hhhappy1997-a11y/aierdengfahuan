{
  "schema_version": "1.0",
  "id": "hd2d_placeholder_r5_params",
  "round": "R5",
  "task_id": "cmd-20261109-020321-549-A4",
  "version": "r5.0",
  "owner": "4号工位-美术管线与工具链",
  "purpose": "R5 边界收口：无源图时可落地的程序化 _draw() 占位兜底参数补充。与 hd2d_placeholder.md 配套；不产 .gd/.tscn/shader（落地实现归 1 号）。",
  "based_on": [
    "HD-2D视觉规范.md §3 / §4 / §7",
    "hd2d_placeholder_params.json (R2, 冻结, 18 键)"
  ],
  "not_a_redelivery": "既有冻结件一律引用、不重做、不覆盖；本文件仅补 R5 落地视图与自检判据。",
  "node_structure": {
    "root": "Node2D (或 Control) 单节点",
    "method": "_draw()",
    "inputs": ["cam_x", "cam_y", "Time.get_ticks_msec()"],
    "buffer": [640, 360],
    "integer_scale": 3,
    "scale_allowed": [2, 3, 4],
    "filter": "Nearest",
    "per_frame": "queue_redraw()",
    "debug_switch": "placeholder_enabled"
  },
  "draw_pass_count": 10,
  "parallax_layer_count": 9,
  "parallax": [
    { "id": "bg_0_sky", "coefficient": 0.05, "draw_order": 0 },
    { "id": "bg_1_far", "coefficient": 0.15, "draw_order": 1 },
    { "id": "bg_2_mid", "coefficient": 0.35, "draw_order": 2 },
    { "id": "bg_3_near", "coefficient": 0.70, "draw_order": 3 },
    { "id": "fx_0_back", "coefficient": 0.45, "draw_order": 4 },
    { "id": "entity", "coefficient": 1.00, "draw_order": 5 },
    { "id": "fx_1_front", "coefficient": 1.00, "draw_order": 6 },
    { "id": "fg_0_occl", "coefficient": 1.25, "draw_order": 7 },
    { "id": "ui", "coefficient": 0.00, "draw_order": 8 }
  ],
  "pass_note": "10 步 = 9 视差层 + 1 步湿地倒影(reflection，挂在 bg_3_near 内效果、不单独计层)。",
  "transform_formula": {
    "ox": "round(-cam_x * layer.parallax)",
    "oy": "round(-cam_y * layer.parallax * 0.3) if layer.id in [bg_0_sky, bg_1_far] else 0",
    "apply": "draw_set_transform(Vector2(ox, oy), 0.0, Vector2.ONE)",
    "reset_before_ui": "draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)"
  },
  "primitives": {
    "sky_bands": { "count": 64, "call": "draw_rect", "color_from": "#16233F", "color_to": "#2B3A5C" },
    "far_mid_silhouette": { "call": "draw_colored_polygon", "colors": ["#2B3A5C", "#4A6089", "#6E6453"] },
    "ground": { "call": "draw_rect", "color": "#29251F", "wet_mask_color": "#16233F" },
    "volumetric_light": { "call": "draw_colored_polygon", "layers": 4, "alpha": [0.18, 0.12, 0.07, 0.04], "color_hex": "#FFD27A" },
    "light_motes": { "call": "draw_circle", "radius_px": 1, "blend": "Add" },
    "wet_reflection": { "call": "draw_rect", "y_mirror": "2*ground_y - py - h", "squash": 0.70, "alpha": 0.35, "ripple": 0.03 },
    "entity": { "call": "draw_rect", "grid": [32, 32], "anchor": [16, 31], "block": [1, 1], "outline_hex": "#0B1226", "max_colors": 16 },
    "bloom": { "call": "draw_circle", "radii": [4, 8, 14, 22, 32], "alpha": [0.20, 0.12, 0.07, 0.04, 0.02], "color_hex": "#FFD27A" },
    "fg_occl": { "call": "draw_colored_polygon", "color": "#0B1226", "alpha": 0.9 },
    "ui": { "call": "draw_rect", "panel_hex": "#0E1B33", "panel_alpha": 0.92, "gold_line_hex": "#E8C479", "border_px": 1, "margin_px": 8, "corner_px": 8 }
  },
  "four_effects_focus": {
    "parallax": { "enabled": true, "layer_count": 9, "offset_rounding": "round()" },
    "light_motes": { "enabled": true, "count_far": 48, "count_near": 32, "size_px": [1, 3], "lifetime_s": [4, 8], "speed_px_s": [2, 6], "sway_px": 3, "sway_period_s": [2, 4], "far_color_hex": "#BFD0EA", "far_alpha": 0.25, "near_color_hex": "#FFD27A", "near_alpha": 0.45 },
    "wet_reflection": { "enabled": true, "alpha": 0.35, "vertical_squash": 0.70, "ripple": 0.03, "align": "脚底 Y 对齐，降采样到与主体同一像素网格，禁止半像素错位", "dry_ground": false },
    "volumetric_light": { "enabled": true, "layer": "fx_0_back", "samples": 48, "density": 0.75, "decay": 0.95, "weight": 0.40, "exposure": 0.32, "color_hex": "#FFD27A", "godray_layers": 4, "godray_alpha": [0.18, 0.12, 0.07, 0.04] }
  },
  "bloom": { "enabled": true, "only_warm_gold_over_threshold": true, "threshold": 0.95, "intensity": 0.50, "radius": 6, "color_hex": "#FFD27A" },
  "placeholder_seed": 20261108,
  "zero_external_dependency": {
    "png": false,
    "comfyui": false,
    "plugin": false,
    "cloud_service": false,
    "paid_api": false,
    "godot_builtin_only": true
  },
  "selfcheck": {
    "json_parseable": true,
    "draw_pass_count": 10,
    "parallax_layer_count": 9,
    "integer_round_only": true,
    "produces_gd_or_tscn": false,
    "claims_image_generation_ready": false
  },
  "policy": {
    "comfyui_is_primary_route": true,
    "qwen_image_is_local_fallback_only": true,
    "placeholder_is_m0_or_degradation_only": true,
    "no_second_gpu_job": true,
    "no_bus_write": true,
    "no_git_commit_push": true,
    "r2_r3_r4_deliverables_untouched": true
  },
  "exit_condition": "assets/generated/bg_layers/ 与 chars/ 有首批合规 spritesheet 且 1 号完成纹理层接入后，逐层把占位绘制替换为 draw_texture_rect() / Sprite 节点；placeholder_enabled 保留为调试开关。"
}
